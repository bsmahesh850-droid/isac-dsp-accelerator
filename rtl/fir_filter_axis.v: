// =====================================================================
// Module: fir_filter_axis
// Description: Pipelined 4-tap symmetric FIR Filter with AXI-Stream Interface
//              Used for radar clutter/noise suppression in 6G ISAC datapath.
// =====================================================================

`timescale 1ns / 1ps

module fir_filter_axis #(
    parameter WIDTH = 16
) (
    input  wire                   clk,
    input  wire                   rst_n,
    
    // AXI-Stream Slave Interface (Raw input samples)
    input  wire [WIDTH-1:0]       s_axis_tdata,
    input  wire                   s_axis_valid,
    output wire                   s_axis_tready,
    
    // AXI-Stream Master Interface (Filtered output samples)
    output reg  [WIDTH-1:0]       m_axis_tdata,
    output reg                    m_axis_valid,
    input  wire                   m_axis_tready
);

    // Delay line registers for input samples
    reg signed [WIDTH-1:0] x0, x1, x2, x3;
    
    // Pipeline registers for MAC (Multiply-Accumulate) operations
    reg signed [WIDTH+2:0] mult_sum; 
    reg                    stage1_valid;
    reg                    stage2_valid;

    // Flow control: ready when downstream is ready
    assign s_axis_tready = m_axis_tready;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            x0           <= {WIDTH{1'b0}};
            x1           <= {WIDTH{1'b0}};
            x2           <= {WIDTH{1'b0}};
            x3           <= {WIDTH{1'b0}};
            stage1_valid <= 1'b0;
            stage2_valid <= 1'b0;
            m_axis_valid <= 1'b0;
            m_axis_tdata <= {WIDTH{1'b0}};
            mult_sum     <= 0;
        end else if (s_axis_tready) begin
            // -------------------------------------------------------------
            // Pipeline Stage 1: Input Shift Register & Valid Propagation
            // -------------------------------------------------------------
            if (s_axis_valid) begin
                x0 <= $signed(s_axis_tdata);
                x1 <= x0;
                x2 <= x1;
                x3 <= x2;
                stage1_valid <= 1'b1;
            end else begin
                stage1_valid <= 1'b0;
            end

            // -------------------------------------------------------------
            // Pipeline Stage 2: Symmetric FIR Multiplications & Accumulation
            // Coefficients: h = [1, 3, 3, 1] (Symmetric optimization)
            // Equation: Y = (x0 + x3)*1 + (x1 + x2)*3
            // -------------------------------------------------------------
            if (stage1_valid) begin
                mult_sum <= ($signed(x0) + $signed(x3)) * 1 + ($signed(x1) + $signed(x2)) * 3;
                stage2_valid <= 1'b1;
            end else begin
                stage2_valid <= 1'b0;
            end

            // -------------------------------------------------------------
            // Pipeline Stage 3: Normalization / Scaling & Output Registration
            // Since coefficients sum to 8 (2^3), we right shift by 3 to normalize
            // -------------------------------------------------------------
            if (stage2_valid) begin
                m_axis_tdata <= mult_sum >>> 3;
                m_axis_valid <= 1'b1;
            end else begin
                m_axis_valid <= 1'b0;
            end
        end
    end

endmodule
